# ==================================
# Noiz Production Environment
# ==================================
#
# Optimized for production deployment with PostgreSQL
#
# Setup:
#   1. Create PostgreSQL database and user
#   2. Copy this file: cp .env.production.example .env
#   3. Edit .env with actual credentials
#   4. Ensure NEVER committed to version control
#   5. Load: set -a && source .env && set +a
#   6. Run migrations: uv run noiz db upgrade
#
# SECURITY: Keep this file secure!
#   chmod 600 .env
#   chown noiz:noiz .env

# Database: PostgreSQL
NOIZ_DATABASE_BACKEND=postgresql

# PostgreSQL connection (replace with your credentials)
NOIZ_DATABASE_URL=postgresql+psycopg2://noiz:CHANGE_THIS_PASSWORD@localhost:5432/noiz_prod

# Processed data directory (must exist with correct permissions)
NOIZ_PROCESSED_DATA_DIR=/data/noiz/processed

# MSeedIndex executable
NOIZ_MSEEDINDEX_EXECUTABLE=mseedindex

# Production mode (disables debug features)
NOIZ_FLASK_ENV=production

# Production logging (INFO is recommended)
NOIZ_LOGLEVEL=INFO
