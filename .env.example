# ==================================
# Noiz Environment Configuration Example
# ==================================
#
# This is a template file. Copy it to .env and customize for your environment.
#
# Quick start:
#   1. Copy this file: cp .env.example .env
#   2. Edit .env with your settings
#   3. Load environment: source .env (or use direnv)
#   4. Run migrations: uv run noiz db upgrade
#   5. Start using Noiz: uv run noiz --help
#
# IMPORTANT: Never commit .env files with secrets to version control!

# ==================================
# DATABASE CONFIGURATION
# ==================================

# Database backend: sqlite or postgresql
# - sqlite: Good for development, testing, single-user
# - postgresql: Required for production, multi-user
NOIZ_DATABASE_BACKEND=sqlite

# Database connection URL
#
# SQLite examples:
#   sqlite:///noiz.db                          # Relative path
#   sqlite:////absolute/path/to/database.db     # Absolute path (4 slashes)
#   sqlite:////tmp/noiz_test.db                # Temp directory
#
# PostgreSQL examples:
#   postgresql+psycopg2://user:password@localhost:5432/noiz
#   postgresql+psycopg2://user:password@dbserver.example.com:5432/noiz_prod
#
NOIZ_DATABASE_URL=sqlite:///noiz.db

# ==================================
# POSTGRESQL-SPECIFIC (Alternative to DATABASE_URL)
# ==================================
#
# If you prefer to specify PostgreSQL parameters separately,
# uncomment and configure these instead of using NOIZ_DATABASE_URL.
# All five parameters are required if using this method.
#
# NOIZ_POSTGRES_HOST=localhost
# NOIZ_POSTGRES_PORT=5432
# NOIZ_POSTGRES_USER=noiz
# NOIZ_POSTGRES_PASSWORD=your_password_here
# NOIZ_POSTGRES_DB=noiz

# ==================================
# REQUIRED: PROCESSED DATA DIRECTORY
# ==================================

# Directory where processed seismic data will be stored
# - Must be empty or non-existent (will be created automatically)
# - Use absolute paths to avoid confusion
# - Requires sufficient disk space (can grow large)
#
# Examples:
#   /tmp/noiz-data                    # Temporary (for development/testing)
#   /data/noiz/processed              # Production path
#   /home/user/noiz-data              # User home directory
#
NOIZ_PROCESSED_DATA_DIR=/tmp/noiz-data

# ==================================
# OPTIONAL: MSEEDINDEX EXECUTABLE
# ==================================

# Path to mseedindex executable
# - Auto-discovered from PATH if not set
# - Only set if auto-discovery fails or you need a specific version
#
# Examples:
#   mseedindex                        # Use from PATH (default)
#   /usr/local/bin/mseedindex        # Absolute path
#   /opt/mseedindex/bin/mseedindex   # Custom installation
#
# NOIZ_MSEEDINDEX_EXECUTABLE=mseedindex

# ==================================
# OPTIONAL: FLASK ENVIRONMENT
# ==================================

# Flask environment mode
# - development: Enables debug mode, debug toolbar, verbose logging
# - production: Disables debug features for security and performance
#
# Default: development
NOIZ_FLASK_ENV=development

# ==================================
# OPTIONAL: LOGGING LEVEL
# ==================================

# Application logging verbosity
# Valid values: DEBUG, INFO, WARNING, WARN, ERROR, CRITICAL
#
# - DEBUG: Very verbose, shows all operations
# - INFO: Normal logging, shows important events
# - WARNING: Only warnings and errors
# - ERROR: Only errors and critical issues
#
# Default: INFO
NOIZ_LOGLEVEL=INFO

# ==================================
# OPTIONAL: SQLALCHEMY WARNINGS
# ==================================

# Enable SQLAlchemy 2.0 compatibility warnings
# Useful during development to prepare for future SQLAlchemy upgrades
#
# SQLALCHEMY_WARN_20=1
