# ==================================
# Noiz Development Environment
# ==================================
#
# Optimized for local development with SQLite
#
# Setup:
#   cp .env.development.example .env
#   set -a && source .env && set +a
#   uv run noiz db upgrade

# Database: SQLite (local file)
NOIZ_DATABASE_BACKEND=sqlite
NOIZ_DATABASE_URL=sqlite:///noiz_dev.db

# Processed data in temp directory
NOIZ_PROCESSED_DATA_DIR=/tmp/noiz-dev-data

# MSeedIndex (auto-discovered from PATH)
# NOIZ_MSEEDINDEX_EXECUTABLE=mseedindex

# Development mode (enables debug features)
NOIZ_FLASK_ENV=development

# Verbose logging for debugging
NOIZ_LOGLEVEL=DEBUG

# Enable SQLAlchemy 2.0 warnings
SQLALCHEMY_WARN_20=1
