# ==================================
# Noiz Testing Environment
# ==================================
#
# Optimized for running tests
#
# Setup:
#   cp .env.testing.example .env.test
#   set -a && source .env.test && set +a
#   just unit_tests

# Database: SQLite (temp file for tests)
NOIZ_DATABASE_BACKEND=sqlite
NOIZ_DATABASE_URL=sqlite:////tmp/noiz_test.db

# Processed data in temp directory
NOIZ_PROCESSED_DATA_DIR=/tmp/noiz-test-data

# MSeedIndex (auto-discovered)
NOIZ_MSEEDINDEX_EXECUTABLE=mseedindex

# Development mode for verbose test output
NOIZ_FLASK_ENV=development

# Debug logging for troubleshooting test failures
NOIZ_LOGLEVEL=DEBUG

# Enable SQLAlchemy warnings
SQLALCHEMY_WARN_20=1
